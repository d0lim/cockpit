package screen

import (
	"github.com/d0lim/cockpit/internal/contract"
	"github.com/d0lim/cockpit/internal/hub/api"
	"github.com/d0lim/cockpit/internal/wire"
)

templ wirePage(st *state) {
	@runHead(st)
	@wireRegion(st)
	@wireCallPanel(st)
}

templ wireRegion(st *state) {
	<section id="wire" class="explorer">
		if v, err := st.wireView(); err != nil {
			@flowTreeNav(st.stepTree(treePick{}), treePick{})
			<div class="detail">
				if f := findFlow(st.treeFlows(), st.query.Get("flow")); f != nil {
					@pickHead(st, *f, pickedStep(*f, st.query.Get("step")), "")
					@paneTabs(st, f.ID, stepID(pickedStep(*f, st.query.Get("step"))), paneCalls, true)
				}
				if wireNotHeld(err) {
					<p class="notice tone-warn">The record holds no call here: { err.Error() }.</p>
				} else {
					<p class="notice tone-bad">The wire record cannot be read: { err.Error() }</p>
				}
				<p class="text-sm"><a class="link" href={ templ.SafeURL(st.path) }>Back to the first step</a></p>
			</div>
		} else if v.Status != api.WireReady {
			@flowTreeNav(st.stepTree(treePick{}), treePick{})
			<div class="detail">
				for _, n := range wireNotes(v) {
					<p class={ "notice", "tone-" + string(n.tone) }>{ n.text }</p>
				}
			</div>
		} else {
			@flowTreeNav(st.callTree(v), wirePick(v))
			<div class="detail">
				@wirePickHead(st, v)
				for _, n := range wireNotes(v) {
					<p class={ "notice", "tone-" + string(n.tone) }>{ n.text }</p>
				}
				@wireTakes(st, v)
				@wireRoutes(st, v)
				@wireCalls(st, v)
			</div>
		}
	</section>
}

func wirePick(v api.WireView) treePick {
	switch v.Scope {
	case api.WireScopeStep:
		return treePick{v.Flow, v.Step}
	case api.WireScopeFlow:
		return treePick{flow: v.Flow}
	}
	return treePick{}
}

templ wirePickHead(st *state, v api.WireView) {
	if f := findFlow(st.treeFlows(), v.Flow); f != nil && v.Take == wire.SuiteTake && v.Scope != api.WireScopeOutside {
		@pickHead(st, *f, pickedStep(*f, v.Step), "")
		@paneTabs(st, v.Flow, v.Step, paneCalls, true)
		if v.Scope == api.WireScopeFlow {
			<p class="text-xs text-muted">{ wireFlowHint }</p>
		}
	} else if f := findFlow(st.takeFlows(v), v.Flow); f != nil && v.Scope != api.WireScopeOutside {
		@takeHead(v.Take, *f, pickedStep(*f, v.Step))
		if v.Scope == api.WireScopeFlow {
			<p class="text-xs text-muted">{ wireFlowHint }</p>
		}
	} else if title, sub := wireStepHeading(v); true {
		<div class="space-y-1">
			<h2 class="detail-title font-mono">{ title }</h2>
			if sub != "" {
				<p class="text-sm text-muted">{ sub }</p>
			}
		</div>
	}
}

templ takeHead(take string, f contract.FlowSummary, s *contract.FlowStep) {
	<div class="space-y-2">
		<p class="flex flex-wrap items-center gap-1.5 font-mono text-xs text-muted">
			<span>{ f.ID }</span>
			if s != nil {
				<span>›</span>
				<span class="text-fg">{ s.ID }</span>
			}
			<span class="ml-auto font-sans">take { take }</span>
		</p>
		<div class="flex flex-wrap items-start gap-2">
			if s != nil {
				<h2 class="detail-title" title={ orElse(s.Title, s.ID) }>{ orElse(s.Title, f.ID+" › "+s.ID) }</h2>
				@badge(flowTone(string(s.Status)), statusLabel(string(s.Status)))
			} else {
				<h2 class="detail-title" title={ orElse(f.Title, f.ID) }>{ orElse(f.Title, f.ID) }</h2>
				@badge(flowTone(string(f.Status)), statusLabel(string(f.Status)))
			}
		</div>
		<p class="text-xs text-muted">{ itoa(f.Passed) } of { itoa(f.Steps) } steps passed in this take.</p>
	</div>
}

templ wireTakes(st *state, v api.WireView) {
	if len(v.Takes) > 1 {
		<nav class="flex flex-wrap items-center gap-1" aria-label="Takes">
			<span class="mr-1 text-xs text-muted">Take</span>
			for _, t := range wireTakeOrder(v.Takes) {
				<a href={ templ.SafeURL(st.wireTakeHref(t)) } class={ "pill", "font-mono", templ.KV("pill-on", t == v.Take) }>{ t }</a>
			}
		</nav>
	}
}

templ wireRoutes(st *state, v api.WireView) {
	if len(v.Routes) > 0 {
		<nav class="strip" aria-label="Routes">
			<span class="mr-1 text-xs text-muted">To</span>
			<a href={ templ.SafeURL(st.wireTargetHref("")) } class={ "pill", templ.KV("pill-on", st.query.Get("target") == "") } hx-swap={ keepPlace }>All routes</a>
			for _, r := range v.Routes {
				<a href={ templ.SafeURL(st.wireTargetHref(r.Name)) } class={ "pill", templ.KV("pill-on", st.query.Get("target") == r.Name) } hx-swap={ keepPlace } title={ wireCount(r.Calls) + " in this take" }>{ r.Name }</a>
			}
		</nav>
	}
}

templ wireCalls(st *state, v api.WireView) {
	@wireViewBar(st, v)
	if st.wireViewName() == wireViewCalls {
		@wireCallRows(st, v)
	} else if len(v.Calls) > 0 {
		@wireDiagram(st.wireScene(v))
		@wireLegend()
	}
	if v.Total > v.Limit {
		<nav class="flex items-center gap-3 text-sm" aria-label="Pages">
			if v.Offset > 0 {
				<a class="link" href={ templ.SafeURL(st.wireOffsetHref(v.Offset - v.Limit)) }>Earlier calls</a>
			}
			if v.Offset+v.Limit < v.Total {
				<a class="link" href={ templ.SafeURL(st.wireOffsetHref(v.Offset + v.Limit)) }>Later calls</a>
			}
		</nav>
	}
}

templ wireCallRows(st *state, v api.WireView) {
	if linked, timed := wireRows(v.Calls); true {
		if len(linked) > 0 {
			@wireTable(st, linked)
		}
		if len(timed) > 0 {
			<div class="space-y-2 opacity-70">
				<h4 class="text-xs font-semibold text-muted">During this step, not tied to it</h4>
				@wireTable(st, timed)
			</div>
		}
	}
}

templ wireTable(st *state, rows []wireRow) {
	<div class="card overflow-x-auto p-0">
		<table class="grid-table">
			<thead>
				<tr><th>Time</th><th>Call</th><th>Result</th><th>Took</th></tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr class={ templ.KV("row-on", st.query.Get("call") == itoa64(r.head.Seq)) } data-seq={ itoa64(r.head.Seq) } data-link={ string(r.head.Link) } data-depth={ itoa(r.head.Depth) } if st.query.Get("call") == itoa64(r.head.Seq) { data-scroll-here={ wireScrollKey(r.head.Seq) } }>
						<td class="font-mono text-xs whitespace-nowrap text-muted">{ r.offset }</td>
						<td class="w-full font-mono text-xs">
							<div class={ wireIndent(r.head.Depth) }>
								<a class="link break-all" href={ templ.SafeURL(st.wireCallHref(r.head.Seq)) } hx-swap={ keepPlace }>{ r.head.Method } { orElse(r.head.Path, "(path not kept)") }</a>
								if r.head.Link == "time" || r.head.Link == "background" {
									<span class="ml-1 font-sans">
										@badge(ToneIdle, string(r.head.Link))
									</span>
								}
								<div class="mt-0.5 text-[11px] text-muted">
									if r.head.Depth > 0 {
										<span>↳ </span>
									}
									{ r.head.Caller } → { r.head.Target }
								</div>
							</div>
						</td>
						<td class="whitespace-nowrap">
							if tone, text := wireResult(r.head); true {
								@badge(tone, text)
							}
							if r.head.Status != 0 && r.head.Outcome != "answered" {
								<span class="ml-1 text-xs text-muted">{ wireOutcomes[r.head.Outcome] }</span>
							}
						</td>
						<td class="text-xs whitespace-nowrap text-muted">{ wireDuration(r.head) }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ wireRunNotice(st *state) {
	if n, ok := st.wireRunNote(); ok {
		<p class={ "notice", "tone-" + string(n.tone) }>
			{ n.text }
			if served(*st.run, st.list) {
				<a class="link ml-1" href={ templ.SafeURL("/runs/" + st.run.ID + "/wire") }>Open its calls</a>
			}
		</p>
	}
}
