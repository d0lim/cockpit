package screen

import "github.com/d0lim/cockpit/internal/hub/api"

templ wirePage(st *state) {
	@runHead(st)
	@question("What was each server asked, and what did it answer", "Every call the recorder saw during a step: who called whom, what was sent and what came back.")
	@wireRegion(st)
	@wireCallPanel(st)
}

templ wireRegion(st *state) {
	<section id="wire" class="space-y-4">
		if v, err := st.wireView(); err != nil {
			<p class="notice tone-bad">The wire record cannot be read: { err.Error() }</p>
			<p class="text-sm"><a class="link" href={ templ.SafeURL(st.path) }>Back to the first step</a></p>
		} else {
			for _, n := range wireNotes(v) {
				<p class={ "notice", "tone-" + string(n.tone) }>{ n.text }</p>
			}
			if v.Status == api.WireReady {
				@wireTakes(st, v)
				<div class="grid gap-4 lg:grid-cols-[16rem_minmax(0,1fr)]">
					@wireStepList(st, v)
					<div class="min-w-0 space-y-3">
						@wireSelection(st, v)
						@wireCalls(st, v)
					</div>
				</div>
			}
		}
	</section>
}

templ wireTakes(st *state, v api.WireView) {
	if len(v.Takes) > 1 {
		<nav class="flex flex-wrap items-center gap-1" aria-label="Takes">
			<span class="mr-1 text-xs text-muted">Take</span>
			for _, t := range wireTakeOrder(v.Takes) {
				<a href={ templ.SafeURL(st.wireTakeHref(t)) } class={ "pill", "font-mono", templ.KV("pill-on", t == v.Take) }>{ t }</a>
			}
		</nav>
	}
}

templ wireStepList(st *state, v api.WireView) {
	<nav class="card self-start p-0" aria-label="Steps">
		for _, f := range wireFlows(v.Steps) {
			<h3 class="px-4 pt-3 pb-1 font-mono text-xs font-semibold text-muted">{ f.id }</h3>
			<ol class="divide-y divide-line">
				for _, s := range f.steps {
					<li>
						<a href={ templ.SafeURL(st.wireStepHref(s)) } class={ "step-row", templ.KV("step-on", wireStepOn(v, s)) } if wireStepOn(v, s) { aria-current="true" }>
							<span class="flex items-center gap-2 text-sm">
								<span class={ "dot", "tone-" + string(flowTone(string(s.Status))) } title={ statusLabel(string(s.Status)) }></span>
								<span class="min-w-0 truncate" title={ orElse(s.Title, s.Step) }>{ orElse(s.Title, s.Step) }</span>
								<span class="ml-auto shrink-0 text-xs text-muted">{ itoa(s.Calls()) }</span>
							</span>
						</a>
					</li>
				}
			</ol>
		}
		<a href={ templ.SafeURL(st.wireOutsideHref()) } class={ "step-row", "border-t", "border-line", templ.KV("step-on", v.Scope == api.WireScopeOutside) }>
			<span class="flex items-center gap-2 text-sm">
				<span>Outside any step</span>
				<span class="ml-auto shrink-0 text-xs text-muted">{ itoa(v.Outside) }</span>
			</span>
		</a>
	</nav>
}

templ wireSelection(st *state, v api.WireView) {
	if title, sub := wireStepHeading(v); true {
		<div>
			<h3 class="font-mono text-sm font-semibold">{ title }</h3>
			if sub != "" {
				<p class="text-sm text-muted">{ sub }</p>
			}
		</div>
	}
	if len(v.Routes) > 0 {
		<nav class="flex flex-wrap gap-1" aria-label="Routes">
			<a href={ templ.SafeURL(st.wireTargetHref("")) } class={ "pill", templ.KV("pill-on", st.query.Get("target") == "") }>All routes</a>
			for _, r := range v.Routes {
				<a href={ templ.SafeURL(st.wireTargetHref(r.Name)) } class={ "pill", templ.KV("pill-on", st.query.Get("target") == r.Name) } title={ wireCount(r.Calls) + " in this take" }>{ r.Name }</a>
			}
		</nav>
	}
}

templ wireCalls(st *state, v api.WireView) {
	if linked, timed := wireRows(v.Calls); true {
		<p class="text-xs text-muted">{ wirePageText(v) }</p>
		if len(linked) > 0 {
			@wireTable(st, linked)
		}
		if len(timed) > 0 {
			<div class="space-y-2 opacity-70">
				<h4 class="text-xs font-semibold text-muted">During this step, matched by time only</h4>
				@wireTable(st, timed)
			</div>
		}
		if v.Total > v.Limit {
			<nav class="flex items-center gap-3 text-sm" aria-label="Pages">
				if v.Offset > 0 {
					<a class="link" href={ templ.SafeURL(st.wireOffsetHref(v.Offset - v.Limit)) }>Earlier calls</a>
				}
				if v.Offset+v.Limit < v.Total {
					<a class="link" href={ templ.SafeURL(st.wireOffsetHref(v.Offset + v.Limit)) }>Later calls</a>
				}
			</nav>
		}
	}
}

templ wireTable(st *state, rows []wireRow) {
	<div class="card overflow-x-auto p-0">
		<table class="grid-table">
			<thead>
				<tr><th>Time</th><th>Call</th><th>Request</th><th>Result</th><th>Took</th></tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr class={ templ.KV("row-on", st.query.Get("call") == itoa64(r.head.Seq)) } data-seq={ itoa64(r.head.Seq) } data-link={ string(r.head.Link) } data-depth={ itoa(r.head.Depth) }>
						<td class="font-mono text-xs whitespace-nowrap text-muted">{ r.offset }</td>
						<td class="font-mono text-xs">
							<div class={ wireIndent(r.head.Depth) }>
								if r.head.Depth > 0 {
									<span class="text-muted">↳ </span>
								}
								{ r.head.Caller } → { r.head.Target }
							</div>
						</td>
						<td class="font-mono text-xs break-all">
							<a class="link" href={ templ.SafeURL(st.wireCallHref(r.head.Seq)) }>{ r.head.Method } { orElse(r.head.Path, "(path not kept)") }</a>
							if r.head.Link == "time" {
								<span class="ml-1">
									@badge(ToneIdle, "time")
								</span>
							}
						</td>
						<td class="whitespace-nowrap">
							if tone, text := wireResult(r.head); true {
								@badge(tone, text)
							}
							if r.head.Status != 0 && r.head.Outcome != "answered" {
								<span class="ml-1 text-xs text-muted">{ wireOutcomes[r.head.Outcome] }</span>
							}
						</td>
						<td class="text-xs whitespace-nowrap text-muted">{ wireDuration(r.head) }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ wireRunNotice(st *state) {
	if n, ok := st.wireRunNote(); ok {
		<p class={ "notice", "tone-" + string(n.tone) }>
			{ n.text }
			if served(*st.run, st.list) {
				<a class="link ml-1" href={ templ.SafeURL("/runs/" + st.run.ID + "/wire") }>Open the Wire screen</a>
			}
		</p>
	}
}
