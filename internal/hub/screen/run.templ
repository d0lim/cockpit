package screen

import (
	"github.com/d0lim/cockpit/internal/hub/api"
	"github.com/d0lim/cockpit/internal/hub/lifecycle"
)

type tabLink struct {
	id    string
	label string
	href  string
}

func runTabs(st *state) []tabLink {
	base := "/runs/" + st.run.ID
	tabs := []tabLink{{TabOverview, "Overview", base}}
	if served(*st.run, st.list) {
		tabs = append(tabs,
			tabLink{TabFlows, "Flows", base + "/report"},
			tabLink{TabSignals, "Signals", base + "/signals/trace"},
			tabLink{TabEnv, "Environment", base + "/env"},
		)
	}
	return append(tabs, tabLink{TabPipeline, "Pipeline", base + "/pipeline"})
}

func tabClass(on bool) string {
	if on {
		return "tab tab-on"
	}
	return "tab"
}

templ runHead(st *state) {
	<header id="run-head" class="run-head" data-head>
		<div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
			<a href="/" class="text-sm text-muted hover:text-fg">Runs</a>
			<span class="text-muted">/</span>
			<h1 class="run-id">{ st.run.ID }</h1>
			if st.run.VerdictLabel != nil {
				<span class={ "badge", "tone-" + string(verdictTone(st.run.Verdict)) }>
					<span aria-hidden="true">{ markOfRun(*st.run).glyph }</span>
					<span class="sr-only">verdict</span>
					{ *st.run.VerdictLabel }
				</span>
			}
			@badge(phaseTone(*st.run), st.run.PhaseLabel)
			if st.run.Keep {
				@badge(ToneInfo, "keep")
			}
			@actions(st, st.detail())
		</div>
		<p class="run-meta">
			<span>suite <span class="text-fg">{ st.run.Suite }</span></span>
			<span>·</span>
			<span>commit <span class="font-mono text-fg">{ short(st.run.SHA) }</span></span>
			<span>·</span>
			<span>by { st.run.Submitter }</span>
			<span>·</span>
			<span>submitted { stamp(st.run.CreatedAt) }</span>
			if took := tookOf(*st.run); took != "" {
				<span>·</span>
				<span>took { took }</span>
			}
			<span>·</span>
			if st.run.Wire && served(*st.run, st.list) {
				<a class="calls-mark calls-on" href={ templ.SafeURL("/runs/" + st.run.ID + "/wire") } title="Submitted with wire: this run's service calls passed through the wire recorder.">calls recorded</a>
			} else if st.run.Wire {
				<span class="calls-mark calls-on" title="Submitted with wire: this run's service calls passed through the wire recorder.">calls recorded</span>
			} else {
				<span class="calls-mark" title="Submitted without wire: this run kept no record of its service calls.">calls not recorded</span>
			}
		</p>
		<nav class="tabs" aria-label="Run screens">
			for _, t := range runTabs(st) {
				<a href={ templ.SafeURL(t.href) } class={ tabClass(t.id == st.tab) } if t.id == st.tab { aria-current="page" }>{ t.label }</a>
			}
		</nav>
	</header>
}

templ overviewPage(st *state) {
	@runHead(st)
	<main class="page page-text">
		@overviewRegion(st)
	</main>
}

templ overviewRegion(st *state) {
	<section id="run-overview" class="space-y-5">
		<div class="card space-y-3">
			<p class="text-base">{ standing(*st.run) }</p>
			for _, n := range notices(*st.run, st.list) {
				<p class="notice tone-warn">{ n }</p>
			}
			@stoppedAt(st)
			@wireRunNotice(st)
			@stages(*st.run)
		</div>
		<div class="card">
			<dl class="kv">
				<dt>Commit</dt>
				<dd class="font-mono">
					{ st.run.SHA }
					<button type="button" class="link ml-2 text-xs" data-copy={ st.run.SHA }>copy</button>
				</dd>
				<dt>Suite</dt>
				<dd>{ st.run.Suite }</dd>
				<dt>Submitted</dt>
				<dd>{ stamp(st.run.CreatedAt) } by { st.run.Submitter }</dd>
				if st.run.StartedAt != "" {
					<dt>Started</dt>
					<dd>{ stamp(st.run.StartedAt) }</dd>
				}
				if st.run.FinishedAt != "" {
					<dt>Finished</dt>
					<dd>
						{ stamp(st.run.FinishedAt) }
						if took := tookOf(*st.run); took != "" {
							<span class="text-muted">· took { took }</span>
						}
					</dd>
				}
				<dt>Host API</dt>
				<dd>{ itoa(st.run.HostAPI) } · cockpit { st.run.CockpitVersion }</dd>
			</dl>
		</div>
	</section>
}

templ stoppedAt(st *state) {
	if served(*st.run, st.list) {
		if v, err := st.report(); err == nil && v.StoppedAt != nil {
			<div class="space-y-2">
				<p class="text-sm">
					Stopped at
					<a class="link font-mono" href={ templ.SafeURL(stepPath(st.run.ID, v.StoppedAt.Flow, v.StoppedAt.Step)) }>{ v.StoppedAt.Flow } › { v.StoppedAt.Step }</a>
				</p>
				if v.StoppedAt.Message != "" {
					<pre class="failure">{ v.StoppedAt.Message }</pre>
				}
			</div>
		}
	}
}

templ stages(r api.RunItem) {
	<ol class="flex flex-wrap items-center gap-2 text-xs" aria-label="Pipeline stages">
		for _, s := range stageSteps(r) {
			<li class={ "stage", "stage-" + s.state }>{ s.label }</li>
		}
	</ol>
}

templ actions(st *state, d *api.RunDetail) {
	<div class="run-actions" aria-label="Actions">
		if allowed(d, lifecycle.Resume) {
			@actionButton(st, "resume", "Resume", "btn btn-primary", "")
		}
		if allowed(d, lifecycle.Stop) {
			@actionButton(st, "stop", "Stop", "btn", confirmText("stop", *st.run))
		}
		if allowed(d, lifecycle.Abort) {
			@actionButton(st, "abort", "Abort", "btn", confirmText("abort", *st.run))
		}
		if !keepFrozen(*st.run) {
			if st.run.Keep {
				@actionButton(st, "unkeep", "Release keep", "btn", confirmText("unkeep", *st.run))
			} else {
				@actionButton(st, "keep", "Keep", "btn", "")
			}
		}
		if allowed(d, lifecycle.Destroy) {
			@actionButton(st, "destroy", "Destroy", "btn btn-danger", confirmText("destroy", *st.run))
		}
		if noActions(*st.run, d) {
			<span class="text-xs text-muted">No environment, no actions</span>
		}
	</div>
}

templ actionButton(st *state, op, label, class, confirm string) {
	<form hx-post={ "/runs/" + st.run.ID + "/do/" + op } hx-target="#action-result" hx-swap="innerHTML" if confirm != "" { hx-confirm={ confirm } }>
		if needsForce(op, *st.run) {
			<input type="hidden" name="force" value="1"/>
		}
		<button type="submit" class={ class }>{ label }</button>
	</form>
}

templ opResult(op string, r api.RunItem) {
	<p class="notice tone-ok">{ doneText(op) } · now { r.PhaseLabel }</p>
}

templ problemResult(p *api.Problem) {
	<div class="notice tone-bad">
		<p>{ p.Code } · { p.Message }</p>
		if len(p.Candidates) > 0 {
			<p class="mt-2">Runs to stop first, oldest last up first:</p>
			<ol class="mt-1 list-decimal pl-5">
				for _, c := range p.Candidates {
					<li>
						<a href={ templ.SafeURL("/runs/" + c.ID) } class="link font-mono">{ c.ID }</a>
						<span class="text-muted">· last up { stamp(orElse(c.LastUpAt, c.FinishedAt)) }</span>
						if c.Keep {
							<span class="text-muted">· keep</span>
						}
					</li>
				}
			</ol>
		}
	</div>
}

templ pipelinePage(st *state) {
	@runHead(st)
	<main class="page page-text">
		@pipelineRegion(st)
	</main>
}

templ pipelineRegion(st *state) {
	<section id="pipeline" class="space-y-4">
		if jobs := st.jobs(); len(jobs) > 0 {
			for _, j := range jobs {
				<div class="card">
					<div class="mb-2 flex items-center gap-2">
						<h3 class="text-sm font-semibold">{ j.title }</h3>
						if j.code == nil {
							@badge(ToneWarn, "running")
						} else if *j.code == 0 {
							@badge(ToneOK, "exit 0")
						} else {
							@badge(ToneBad, "exit "+itoa(*j.code))
						}
					</div>
					<div class="console log-box"><div>{ j.text() }</div></div>
				</div>
			}
		} else if tail := st.detail(); tail != nil && len(tail.Tail) > 0 {
			<div class="card">
				<p class="mb-2 text-sm text-muted">This hub has no output of this run in memory. The last lines the run kept:</p>
				<pre class="console">{ joinLines(tail.Tail) }</pre>
			</div>
		} else {
			<p class="card text-sm text-muted">No pipeline output in this hub's memory, and the run kept no lines.</p>
		}
	</section>
}
