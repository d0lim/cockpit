package screen

import (
	"github.com/d0lim/cockpit/internal/contract"
	"github.com/d0lim/cockpit/internal/hub/api"
	"github.com/d0lim/cockpit/internal/hub/lifecycle"
)

func addressOf(id string, p api.ServicePort) (string, string) {
	local := "127.0.0.1:" + itoa(p.HostPort)
	switch p.Open {
	case contract.OpenCopy:
		return "", local
	case contract.OpenBrowser:
		return "http://" + id + ".localhost:" + itoa(p.HostPort), id + ".localhost:" + itoa(p.HostPort)
	}
	return "http://" + local, local
}

templ envPage(st *state) {
	@runHead(st)
	@question("How do I get into this environment", "Its service ports, the kit, and the flows you can run again against it.")
	@envRegion(st)
	<div id="exec-result" class="mt-4" aria-live="polite"></div>
}

templ envRegion(st *state) {
	<section id="env" class="space-y-6">
		if kit, err := st.s.d.Reader.Kit(st.run.ID); err != nil {
			<p class="notice tone-bad">The environment cannot be read: { err.Error() }</p>
		} else {
			@ports(st, kit)
			@kitCard(st, kit)
		}
	</section>
}

templ ports(st *state, kit api.KitView) {
	<div>
		<h3 class="mb-2 text-sm font-semibold">Service ports</h3>
		if len(kit.Services) == 0 {
			<p class="card text-sm text-muted">No port block. Only a run with an environment holds ports.</p>
		} else {
			if kit.Env != lifecycle.EnvUp {
				<p class="notice tone-warn mb-2">The environment is { string(kit.Env) }. Resume it on the overview to reach these ports.</p>
			}
			<ul class="card divide-y divide-line p-0">
				for _, p := range kit.Services {
					<li class="flex items-center gap-3 px-4 py-3">
						if s, ok := st.serviceStates()[p.Service]; ok && kit.Env == lifecycle.EnvUp {
							@badge(serviceTone(s), orElse(s.health, s.status))
						}
						<span class="text-sm" title={ p.Service + ":" + itoa(p.Port) }>{ p.Label }</span>
						<span class="ml-auto">
							if href, text := addressOf(st.run.ID, p); href == "" {
								<span class="font-mono text-xs">{ text }</span>
								<button type="button" class="link ml-2 text-xs" data-copy={ text }>copy</button>
							} else {
								<a href={ templ.SafeURL(href) } target="_blank" rel="noreferrer" hx-boost="false" class="link font-mono text-xs">{ text }</a>
							}
						</span>
					</li>
				}
			</ul>
		}
	</div>
}

templ kitCard(st *state, kit api.KitView) {
	<div class="card space-y-4 text-sm">
		if kit.Kit != nil {
			<dl class="kv">
				<dt>Kit directory</dt>
				<dd class="font-mono text-xs">{ kit.Kit.Dir } <button type="button" class="link ml-1" data-copy={ kit.Kit.Dir }>copy</button></dd>
				<dt>README</dt>
				<dd class="font-mono text-xs">{ kit.Kit.Readme } <button type="button" class="link ml-1" data-copy={ kit.Kit.Readme }>copy</button></dd>
			</dl>
		} else {
			<p class="text-muted">The kit exists only while the environment does.</p>
		}
		if kit.Exec != nil {
			<div>
				<h3 class="mb-2 font-semibold">Run a flow again</h3>
				<pre class="console">{ kit.Exec.Command }</pre>
				if len(kit.Exec.Flows) == 0 {
					<p class="mt-2 text-muted">The manifest has not been read yet.</p>
				} else {
					<div class="mt-3 flex flex-wrap gap-2">
						for _, f := range kit.Exec.Flows {
							<form hx-post={ "/runs/" + st.run.ID + "/do/exec" } hx-target="#exec-result" hx-swap="innerHTML">
								<input type="hidden" name="flow" value={ f }/>
								<button type="submit" class="btn font-mono text-xs">{ f }<span class="htmx-indicator ml-1">…</span></button>
							</form>
						}
					</div>
				}
			</div>
		}
		<dl class="kv">
			<dt>Report bundle</dt>
			<dd class="font-mono text-xs">{ kit.ReportDir } <button type="button" class="link ml-1" data-copy={ kit.ReportDir }>copy</button></dd>
		</dl>
	</div>
}

templ execResult(flow string, v api.ExecView) {
	<div class="card space-y-3 text-sm">
		<div class="flex items-center gap-2">
			<span class="font-mono">{ flow }</span>
			if v.ExitCode != nil && *v.ExitCode == 0 {
				@badge(ToneOK, "exit 0")
			} else if v.ExitCode != nil {
				@badge(ToneBad, "exit "+itoa(*v.ExitCode))
			} else {
				@badge(ToneWarn, "no exit code")
			}
			if v.TimedOut {
				@badge(ToneBad, "timed out")
			}
			if v.OOMKilled {
				@badge(ToneBad, "out of memory")
			}
		</div>
		if v.Reason != "" {
			<p>{ v.Reason }</p>
		}
		for _, f := range v.Flows {
			<ul class="divide-y divide-line">
				for _, s := range f.Steps {
					<li class="flex flex-wrap items-center gap-2 py-1">
						<span class="font-mono text-xs">{ f.ID } · { s.ID }</span>
						@badge(flowTone(string(s.Status)), statusLabel(string(s.Status)))
						if s.Message != "" {
							<span class="text-xs text-muted">{ s.Message }</span>
						}
					</li>
				}
			</ul>
		}
		if len(v.Lines) > 0 {
			<pre class="console max-h-80 overflow-y-auto">{ joinLines(v.Lines) }</pre>
		}
	</div>
}
