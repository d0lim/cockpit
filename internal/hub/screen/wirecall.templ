package screen

import (
	"github.com/d0lim/cockpit/internal/hub/api"
	"github.com/d0lim/cockpit/internal/wire"
)

templ wireCallPanel(st *state) {
	if st.query.Get("call") != "" {
		<section id={ wireCallPanelID } class="call-panel" aria-label="Picked call" data-panel>
			if c, err := st.wireCall(); err != nil {
				@wireCallProblem(st, "This call cannot be shown: "+err.Error())
			} else if c == nil {
				@wireCallProblem(st, "The call in this address is not a call number.")
			} else {
				@wireCallHead(st, *c)
				<div class="call-body">
					if c.Call.Withheld {
						<p class="notice tone-warn">This call failed the check that nothing secret remains, so its path, query, span, headers and bodies were not kept.</p>
					} else {
						@wireMessage("Request", c.Call.Request, c.Call.Query)
						@wireMessage("Response", c.Call.Response, wire.Body{})
					}
					<div class="call-part">
						<h3>Why it is listed here</h3>
						<p class="text-sm">
							@badge(wireLinkTone(c.Head.Link), string(c.Head.Link))
							<span class="ml-1">{ c.Why }</span>
						</p>
					</div>
					<p class="text-xs text-muted">Call { itoa64(c.Head.Seq) } · started { wireStamp(c.Head.Started) } · { wireOutcomes[c.Head.Outcome] }</p>
				</div>
			}
		</section>
	}
}

templ wireCallClose(st *state) {
	<a class="close-x" href={ templ.SafeURL(st.wireCloseHref()) } hx-swap={ keepPlace } data-panel-close aria-label="Close the picked call" title="Close (Esc)">×</a>
}

templ wireCallProblem(st *state, text string) {
	<header class="call-head">
		<div class="flex items-center gap-2">
			<h2 class="text-sm font-semibold">Picked call</h2>
			@wireCallClose(st)
		</div>
	</header>
	<div class="call-body">
		<p class="notice tone-bad">{ text }</p>
	</div>
}

templ wireCallHead(st *state, c api.WireCallView) {
	<header class="call-head">
		<div class="flex items-start gap-2">
			@methodTag(c.Head.Method)
			<h2 class="call-path">{ orElse(c.Head.Path, "(path not kept)") }</h2>
			@wireCallClose(st)
		</div>
		<p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
			if tone, text := wireResult(c.Head); true {
				@badge(tone, text)
			}
			<span>{ wireDuration(c.Head) }</span>
			if !c.Call.Withheld {
				<span>·</span>
				<span>{ wireSize(c.Call.Request.Size) } sent, { wireSize(c.Call.Response.Size) } back</span>
			}
			<span>·</span>
			<span class="font-mono text-fg">{ c.Head.Caller } → { c.Head.Target }:{ itoa(c.Head.Port) }</span>
		</p>
	</header>
}

templ wireFieldList(fields []wireField) {
	<dl class="kv kv-tight">
		for _, f := range fields {
			<dt class="font-mono break-all">{ f.key }</dt>
			<dd class="font-mono break-all">
				for _, v := range f.values {
					<div>{ v }</div>
				}
			</dd>
		}
	</dl>
}

templ wireMessage(title string, m wire.Message, query wire.Body) {
	<div class="call-part" role="group" aria-label={ title }>
		<h3>
			{ title }
			<span class="text-xs font-normal text-muted">{ wireSize(m.Size) }</span>
		</h3>
		if fields, text := wireQueryFields(query); len(fields) > 0 || text != "" {
			<div class="space-y-1">
				<p class="label">Query</p>
				<div class="font-mono text-xs break-all">
					if text != "" {
						{ text }
					}
					for _, f := range fields {
						for _, v := range f.values {
							<div>{ f.key } = { v }</div>
						}
					}
				</div>
			</div>
		}
		if b := wireBody(m); true {
			if b.note != "" {
				<p class="text-sm text-muted">{ b.note }</p>
			}
			for _, block := range b.blocks {
				if block.label != "" {
					<p class="label">{ block.label }</p>
				}
				<pre class="console">{ block.text }</pre>
			}
			if len(b.fields) > 0 {
				@wireFieldList(b.fields)
			}
			if b.cut {
				<p class="text-xs text-muted">Shown up to 256 KiB. The rest is in the stored record.</p>
			}
		}
		if headers := wireHeaders(m.Headers); len(headers) > 0 {
			<details class="fold">
				<summary>
					Headers
					<span class="ml-auto tabular-nums">{ itoa(len(headers)) }</span>
				</summary>
				@wireFieldList(headers)
			</details>
		}
	</div>
}
