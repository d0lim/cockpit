package screen

import (
	"net/url"
	"strconv"

	"github.com/d0lim/cockpit/internal/contract"
)

func callHref(st *state, flow, step string, n int) string {
	span := "call:" + flow + "/" + step + "/" + strconv.Itoa(n)
	return "/runs/" + st.run.ID + "/signals/trace?" + url.Values{"trace": {st.run.ID}, "span": {span}}.Encode()
}

func callTone(c contract.StepCall) Tone {
	if c.Status != nil && *c.Status < 400 {
		return ToneOK
	}
	return ToneBad
}

func callStatus(c contract.StepCall) string {
	if c.Status == nil {
		return "no response"
	}
	return strconv.Itoa(*c.Status)
}

func refValues(refs []contract.StepRef) []string {
	out := make([]string, len(refs))
	for i, r := range refs {
		out[i] = r.Value
	}
	return out
}

func refChips(refs []contract.StepRef) []chip {
	out := make([]chip, len(refs))
	for i, r := range refs {
		out[i] = chip{r.Name, r.Value}
	}
	return out
}

func stepSelf(st *state, flow, step string) string {
	return "span\x00" + st.run.ID + "\x00" + stepPrefix + flow + "/" + step
}

var methodTones = map[string]Tone{"GET": ToneOK, "POST": ToneWarn, "PUT": ToneInfo, "PATCH": ToneInfo, "DELETE": ToneBad}

func methodTone(method string) string {
	if t, ok := methodTones[method]; ok {
		return "tone-" + string(t)
	}
	return "tone-idle"
}

templ methodTag(method string) {
	<span class={ "method", methodTone(method) }>{ method }</span>
}

templ stepRecords(st *state, flow string, s contract.FlowStep) {
	<div class="space-y-5" aria-label={ "records of " + s.ID }>
		if len(s.Calls) == 0 && len(s.Refs) == 0 {
			<p class="card text-sm text-muted">This step recorded no request and marked no id.</p>
		}
		if len(s.Calls) > 0 {
			<div class="space-y-2">
				<h3 class="label">Requests the step sent</h3>
				<ol class="rows">
					for i, c := range s.Calls {
						<li class="request-line">
							@methodTag(c.Method)
							<a class="link min-w-0 truncate font-mono" href={ templ.SafeURL(callHref(st, flow, s.ID, i+1)) } title="Open this request's span">{ c.Path }</a>
							<span class="ml-auto flex shrink-0 items-center gap-2 text-muted">
								<span>{ c.Host }</span>
								@badge(callTone(c), callStatus(c))
								<span class="w-14 text-right tabular-nums">{ itoa(int(c.DurationMs)) }ms</span>
								<span class="font-mono">{ clock(c.StartedAt) }</span>
							</span>
						</li>
					}
				</ol>
				if st.run.Wire {
					<p class="text-xs text-muted">
						The bodies of these requests and of the calls they caused are under
						<a class="link" href={ templ.SafeURL(st.callsHref(flow, s.ID)) } hx-swap={ keepPlace }>Calls</a>.
					</p>
				}
			</div>
		}
		if len(s.Refs) > 0 {
			<div class="space-y-2">
				<h3 class="label">Ids this step marked</h3>
				@refLinks(st, refChips(s.Refs))
				@relatedList(st, refValues(s.Refs), stepSelf(st, flow, s.ID))
			</div>
		}
	</div>
}
