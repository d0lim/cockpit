package screen

import "github.com/d0lim/cockpit/internal/hub/api"

templ wireViewBar(st *state, v api.WireView) {
	<div class="flex flex-wrap items-center gap-2">
		<nav class="seg" aria-label="Views">
			for _, name := range wireViewNames {
				<a href={ templ.SafeURL(st.wireViewHref(name)) } class={ templ.KV("seg-on", st.wireViewName() == name) } hx-swap={ keepPlace }>{ wireViewLabel(name) }</a>
			}
		</nav>
		if st.wireViewName() != wireViewCalls {
			<nav class="seg" aria-label="Which calls">
				<a href={ templ.SafeURL(st.wireTiesHref(false)) } class={ templ.KV("seg-on", !st.wireTiedOnly()) } hx-swap={ keepPlace }>All calls</a>
				<a href={ templ.SafeURL(st.wireTiesHref(true)) } class={ templ.KV("seg-on", st.wireTiedOnly()) } hx-swap={ keepPlace }>Tied to the step</a>
			</nav>
		}
		<span class="text-xs text-muted">{ wirePageText(v) }</span>
		if st.wireViewName() != wireViewCalls && len(v.Calls) > 0 {
			<button type="button" class="pill ml-auto" data-copy={ wireMermaid(st.wireModel(v)) }>Copy as Mermaid</button>
		}
	</div>
}

templ wireLegend() {
	<p class="wire-legend">
		<span class="wire-key wire-key-exact">proven by a span</span>
		<span class="wire-key wire-key-nested">inferred from timing</span>
		<span class="wire-key wire-key-background">background work</span>
		<span class="wire-key wire-key-time">same time only</span>
	</p>
}

templ wireDiagram(s wireScene) {
	<div class="wire-scroll" tabindex="0" role="region" aria-label={ s.Label } data-scroll-box="calls">
		<svg class="wire-svg wire-head" width={ wireNum(s.Width) } height={ wireNum(s.HeadHeight) } viewBox={ "0 0 " + wireNum(s.Width) + " " + wireNum(s.HeadHeight) } aria-hidden="true">
			for _, p := range s.HeadPaths {
				<path d={ p.D } class={ p.Class }></path>
			}
			for _, t := range s.Head {
				@wireSvgText(t)
			}
		</svg>
		<svg class="wire-svg" width={ wireNum(s.Width) } height={ wireNum(s.Height) } viewBox={ "0 0 " + wireNum(s.Width) + " " + wireNum(s.Height) }>
			for _, b := range s.Bands {
				<rect x={ wireNum(b.X) } y={ wireNum(b.Y) } width={ wireNum(b.W) } height={ wireNum(b.H) } class={ b.Class }></rect>
			}
			for _, h := range s.Hits {
				<a href={ templ.SafeURL(h.Href) } aria-label={ h.Label } data-seq={ itoa64(h.Seq) }>
					<rect x="0" y={ wireNum(h.Y) } width={ wireNum(s.Width) } height={ wireNum(h.H) } class={ "wire-hit", templ.KV("wire-hit-on", h.On) } if h.Here { data-scroll-here={ wireScrollKey(h.Seq) } }></rect>
				</a>
			}
			for _, p := range s.Lines {
				<path d={ p.D } class={ p.Class }></path>
			}
			for _, b := range s.Bars {
				<rect x={ wireNum(b.X) } y={ wireNum(b.Y) } width={ wireNum(b.W) } height={ wireNum(b.H) } class={ b.Class }></rect>
			}
			for _, p := range s.Paths {
				<path d={ p.D } class={ p.Class }></path>
			}
			for _, t := range s.Texts {
				if t.Href != "" {
					<a href={ templ.SafeURL(t.Href) } aria-label="Show every repeat of this call">
						@wireSvgText(t)
					</a>
				} else {
					@wireSvgText(t)
				}
			}
		</svg>
	</div>
}

templ wireSvgText(t wireText) {
	<text x={ wireNum(t.X) } y={ wireNum(t.Y) } class={ t.Class } if t.Anchor != "" {
	text-anchor={ t.Anchor }
}>
		if t.Tag != "" {
			<tspan class="wire-tag">{ t.Tag }</tspan>
		}
		{ t.Text }
		if t.Note != "" {
			<tspan class="wire-note">{ t.Note }</tspan>
		}
	</text>
}
