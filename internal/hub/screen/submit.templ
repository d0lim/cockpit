package screen

import "github.com/d0lim/cockpit/internal/hub/api"

templ submitForm(st *state) {
	<section class="card" aria-label="Submit a run">
		<h2 class="text-sm font-semibold">Submit a run</h2>
		if repos := st.s.d.Reader.Repositories(); len(repos) == 0 {
			<p class="mt-1 text-sm text-muted">This hub's config lists no allowedRepositories, so runs come only from the CLI: <code class="font-mono">{ submitHint }</code></p>
		} else {
			<p class="mb-3 text-xs text-muted">The suites are the ones the repository declares at the commit you type.</p>
			<form hx-post="/runs/submit" hx-target="#submit-result" hx-swap="innerHTML" class="grid items-end gap-3 sm:grid-cols-[minmax(0,1fr)_9rem_10rem_auto]">
				<label class="grid gap-1 text-xs text-muted">
					Repository
					<select name="worktree" class="field" hx-get="/runs/suites" hx-include="[name='worktree'],[name='commit']" hx-target="#suite-options" hx-swap="innerHTML" hx-trigger="change, load">
						for _, r := range repos {
							<option value={ r }>{ r }</option>
						}
					</select>
				</label>
				<label class="grid gap-1 text-xs text-muted">
					Commit
					<input name="commit" value={ defaultCommit } class="field font-mono" autocomplete="off" hx-get="/runs/suites" hx-include="[name='worktree'],[name='commit']" hx-target="#suite-options" hx-swap="innerHTML" hx-trigger="change"/>
				</label>
				<label class="grid gap-1 text-xs text-muted">
					Suite
					<select name="suite" id="suite-options" class="field">
						<option value="">default</option>
					</select>
				</label>
				<button type="submit" class="btn">Submit</button>
			</form>
			<div id="submit-result" class="mt-3" aria-live="polite"></div>
		}
	</section>
}

templ suiteOptions(view api.SuitesView, problem string) {
	<option value="">default</option>
	for _, s := range view.Suites {
		<option value={ s.Name }>{ s.Name }</option>
	}
	if problem != "" {
		<option value="" disabled>{ problem }</option>
	}
}

templ submittedResult(got api.Submitted) {
	<p class="notice tone-ok">
		{ submittedText(got) }
		<a class="link" href={ templ.SafeURL("/runs/" + got.ID) }>Open the run</a>
	</p>
}
