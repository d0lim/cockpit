package screen

import (
	"github.com/d0lim/cockpit/internal/contract"
	"github.com/d0lim/cockpit/internal/hub/api"
	"github.com/d0lim/cockpit/internal/hub/lifecycle"
)

templ reportPage(st *state) {
	@runHead(st)
	@reportRegion(st)
}

templ reportRegion(st *state) {
	<section id="report" class="explorer">
		@flowTreeNav(st.stepTree(treePick{}), treePick{})
		<div class="detail max-w-5xl">
			@wireRunNotice(st)
			if v, err := st.report(); err != nil {
				<p class="notice tone-bad">The report cannot be read: { err.Error() }</p>
			} else {
				switch v.Status {
					case api.ReportPending:
						<p class="card">The report is written when the run finishes. Now: { v.PhaseLabel }.</p>
					case api.ReportRedactionFailed:
						<div class="card">
							<p class="notice tone-bad">The redaction rescan discarded the bundle. The files it caught:</p>
							<ul class="mt-2 font-mono text-xs">
								for _, f := range v.Files {
									<li>{ f }</li>
								}
							</ul>
						</div>
					case api.ReportMetaOnly:
						@metaOnly(v)
					default:
						@bundleReport(st, v, summaryOf(v))
				}
			}
		</div>
	</section>
}

templ metaOnly(v api.ReportView) {
	<div class="card space-y-3">
		<p>Finished without a bundle. Stopped at the { lifecycle.StageLabel(*v.FailedStage) } stage.</p>
		if v.Notice != nil && *v.Notice != "" {
			<p class="text-sm">Reason: { *v.Notice }</p>
		}
		<h3 class="text-sm font-semibold">Last lines of the failed stage</h3>
		if len(v.Tail) > 0 {
			<pre class="console">{ joinLines(v.Tail) }</pre>
		} else {
			<p class="text-sm text-muted">No lines left.</p>
		}
	</div>
}

templ bundleReport(st *state, v api.ReportView, s contract.Summary) {
	<div class="card space-y-3">
		<div class="flex flex-wrap items-center gap-2">
			if v.VerdictLabel != nil {
				@badge(verdictTone(v.Verdict), "verdict "+*v.VerdictLabel)
			}
			@badge(sealTone(s.Seal), "seal "+orElse(string(s.Seal), "-"))
			if s.Network == contract.NetworkOpen {
				@badge(ToneWarn, "network open")
			}
			if v.Steps != nil {
				<span class="text-sm">
					Steps { count(v.Steps.Actual) } of { count(v.Steps.Expected) } · failed { itoa(v.Steps.Failed) } · skipped { itoa(v.Steps.Skipped) } · requests { itoa(v.Steps.Requests) }
				</span>
			}
		</div>
		if v.StoppedAt != nil {
			<div class="space-y-2">
				<p class="text-sm">
					Stopped at
					<a class="link font-mono" href={ templ.SafeURL(st.flowHref(v.StoppedAt.Flow, v.StoppedAt.Step, "")) }>{ v.StoppedAt.Flow } › { v.StoppedAt.Step }</a>
				</p>
				if v.StoppedAt.Message != "" {
					<pre class="failure">{ v.StoppedAt.Message }</pre>
				}
			</div>
		}
		if len(s.Reasons) > 0 {
			<ul class="list-disc pl-5 text-sm">
				for _, r := range s.Reasons {
					<li>{ r }</li>
				}
			</ul>
		}
		for _, fs := range failedStages(s) {
			<p class="notice tone-bad">Collection failed · { fs.name } { fs.detail }</p>
		}
		if v.StoppedAt == nil && len(s.Reasons) == 0 {
			<p class="text-sm text-muted">Pick a flow on the left to see what it did.</p>
		}
	</div>
	@notProven(st, v.NotProven)
	<div class="card text-sm">
		<span class="text-muted">Report bundle</span>
		<span class="ml-2 font-mono text-xs break-all">{ v.ReportDir }</span>
		<button type="button" class="link ml-2 text-xs" data-copy={ v.ReportDir }>copy</button>
		<a class="link ml-2 text-xs" href={ templ.SafeURL("/api/runs/" + v.ID + "/export") } hx-boost="false" download>Download archive</a>
		<p class="mt-1 text-xs text-muted">The raw files (runner results, signals, sources) are in this directory. The archive holds the same files, masked again, for reading away from the hub.</p>
	</div>
}

templ notProven(st *state, np *contract.NotProven) {
	<div class="card space-y-3">
		<h3 class="text-sm font-semibold">Not counted as passed</h3>
		if groups := skippedByFlow(np); len(groups) > 0 {
			<details class="fold" open?={ skippedCount(np) <= foldAbove }>
				<summary>
					{ itoa(skippedCount(np)) } skipped steps in { itoa(len(groups)) } flows
					<a class="link ml-auto" href={ templ.SafeURL(st.href(map[string][]string{"only": {onlySkipped}})) }>List them in the tree</a>
				</summary>
				<ul class="space-y-1 text-xs">
					for _, g := range groups {
						<li class="flex flex-wrap items-baseline gap-x-2">
							<span class="text-muted">skipped step ·</span>
							<a class="link font-mono" href={ templ.SafeURL(st.flowHref(g.flow, "", "")) }>{ g.flow }</a>
							<span class="text-muted">›</span>
							for _, step := range g.steps {
								<a class="font-mono hover:underline" href={ templ.SafeURL(st.flowHref(g.flow, step, "")) }>{ step }</a>
							}
						</li>
					}
				</ul>
			</details>
		}
		if items := notProvenItems(np); len(items) > 0 {
			<ul class="list-disc pl-5 text-sm">
				for _, item := range items {
					<li>{ item }</li>
				}
			</ul>
		}
		if np == nil || len(np.Skipped)+len(np.Declared)+len(np.Unread) == 0 {
			<p class="text-sm text-muted">Nothing.</p>
		}
	</div>
}

func sealTone(s contract.SealVerdict) Tone {
	switch s {
	case contract.SealPassed:
		return ToneOK
	case contract.SealFailed, contract.SealError:
		return ToneBad
	}
	return ToneIdle
}

templ flowPage(st *state) {
	@runHead(st)
	@flowRegion(st)
}

templ flowRegion(st *state) {
	<section id="flow" class="explorer">
		if pick := (treePick{st.values["flow"], st.query.Get("step")}); true {
			@flowTreeNav(st.stepTree(pick), pick)
		}
		<div class="detail">
			if fv, err := st.flow(); err != nil {
				<p class="notice tone-bad">The flow cannot be read: { err.Error() }</p>
			} else if step := pickedStep(fv.Flow, st.query.Get("step")); true {
				@pickHead(st, fv.Flow, step, fv.Source)
				if step == nil && st.query.Get("step") != "" {
					<p class="notice tone-warn">This flow has no step { st.query.Get("step") }.</p>
				}
				@paneTabs(st, fv.Flow.ID, stepID(step), orElse(st.pane(), paneStep), st.callsTab(fv.Flow, step))
				if st.pane() == paneSource {
					@codeView(st, fv)
				} else if step != nil {
					@stepRecords(st, fv.Flow.ID, *step, st.callsTab(fv.Flow, step))
				} else {
					@flowSteps(st, fv)
				}
			}
		</div>
	</section>
}

templ flowSteps(st *state, fv api.FlowView) {
	if len(fv.Flow.StepList) == 0 {
		<p class="card text-sm text-muted">This report has no step list.</p>
	} else {
		<ol class="rows">
			for _, s := range fv.Flow.StepList {
				<li>
					<a href={ templ.SafeURL(st.flowHref(fv.Flow.ID, s.ID, "")) } class="step-line">
						<span class="flex flex-wrap items-center gap-2">
							@statusMark(string(s.Status))
							<span class="font-mono text-xs text-muted">{ s.ID }</span>
							<span class="text-sm">{ s.Title }</span>
							<span class="ml-auto text-xs text-muted">
								{ string(s.Kind) } · { stepFacts(s) }
								if note := st.stepCallsNote(fv.Flow.ID, s); note != "" {
									· <span class="text-fg">{ note }</span>
								}
							</span>
						</span>
						if s.Message != "" {
							<span class={ "block pl-6 font-mono text-xs whitespace-pre-wrap", templ.KV("text-bad", s.Status == contract.StepStatusFailed), templ.KV("text-muted", s.Status != contract.StepStatusFailed) }>{ s.Message }</span>
						}
					</a>
				</li>
			}
		</ol>
	}
}

func stepID(s *contract.FlowStep) string {
	if s == nil {
		return ""
	}
	return s.ID
}
