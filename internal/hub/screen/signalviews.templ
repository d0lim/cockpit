package screen

import (
	"slices"
	"sort"
	"strconv"

	"github.com/d0lim/cockpit/internal/contract"
)

func sortedKeys(m contract.Attrs) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

func pct(f float64) string { return strconv.FormatFloat(f, 'f', 2, 64) }

func depthClass(d int) string { return "depth-" + itoa(min(d, 8)) }

func pickTrace(traces []traceSummary, id string) string {
	for _, t := range traces {
		if t.id == id {
			return id
		}
	}
	if len(traces) > 0 {
		return traces[0].id
	}
	return ""
}

templ traceView(st *state, snap signalSnapshot, all []contract.Signal) {
	if traces := traceList(all); true {
		@emptyNotice(st, snap, len(traces))
		if len(traces) > 0 {
			if picked := pickTrace(traces, st.query.Get("trace")); true {
				<div class="grid grid-cols-[minmax(0,1fr)] gap-4 lg:grid-cols-[17rem_minmax(0,1fr)]">
					<nav class="rows stick max-h-72" aria-label="Traces" data-scroll-box="traces">
						if listed, hidden := listedTraces(traces, picked); true {
							for _, t := range listed {
								<a class={ "trace-row", templ.KV("event-on", t.id == picked) } href={ templ.SafeURL(st.href(map[string][]string{"trace": {t.id}, "span": nil, "open": nil})) } if t.id == picked { aria-current="true" data-scroll-here={ "trace-" + t.id } }>
									<span class="flex items-center gap-2">
										<span class={ "dot", "tone-" + string(spanTone(t.status)) } title={ string(t.status) }></span>
										<span class="min-w-0 truncate text-[13px] font-medium">{ t.root }</span>
										if t.exec {
											<span class="ml-auto text-[11px] text-muted">exec</span>
										}
										if t.service {
											<span class="ml-auto text-[11px] text-muted">service</span>
										}
									</span>
									<span class="pl-4 text-[11px] text-muted">{ stamp(t.start) } · { durationText(t.duration) } · { itoa(t.spans) } spans · { string(t.status) }</span>
								</a>
							}
							if hidden > 0 {
								<p class="px-3 py-2 text-xs text-muted">{ itoa(hidden) } older service traces are not listed</p>
							}
						}
					</nav>
					@spanList(st, snap, picked, all)
				</div>
			}
		}
	}
}

templ spanList(st *state, snap signalSnapshot, trace string, all []contract.Signal) {
	if byTrace, _ := spansByTrace(all); true {
		if rows := spanRows(byTrace[trace]); true {
			if fold := st.foldSpans(rows); true {
				<div class="min-w-0 space-y-2">
					<p class="flex flex-wrap items-center gap-2 text-xs text-muted">
						<span>{ itoa(len(fold.rows)) } of { itoa(fold.total) } spans shown</span>
						if fold.all {
							<a class="link" href={ templ.SafeURL(st.spanAllHref(false)) } hx-swap={ keepPlace }>Fold to four levels</a>
						} else if len(fold.rows) < fold.total {
							<a class="link" href={ templ.SafeURL(st.spanAllHref(true)) } hx-swap={ keepPlace }>Open every span</a>
						}
					</p>
					<div class={ "grid grid-cols-[minmax(0,1fr)] gap-4", templ.KV("xl:grid-cols-[minmax(0,1fr)_22rem]", pickSpan(rows, st.query.Get("span")) != nil) }>
						<ol class="rows" aria-label={ "spans of " + trace }>
							for _, r := range fold.rows {
								<li class={ "span-row", templ.KV("event-on", r.id == st.query.Get("span")) }>
									<span class={ "span-name", depthClass(r.depth) }>
										if r.toggle != "" {
											<a class="span-toggle" href={ templ.SafeURL(r.toggle) } hx-swap={ keepPlace } title={ foldTitle(r) } aria-label={ foldTitle(r) } aria-expanded={ boolText(r.open) }>
												if r.open {
													▼
												} else {
													▶
												}
											</a>
										} else {
											<span class="size-4 shrink-0"></span>
										}
										<a class="min-w-0 truncate hover:underline" href={ templ.SafeURL(st.href(map[string][]string{"trace": {trace}, "span": {r.id}})) } hx-swap={ keepPlace } title={ r.s.Span.Name }>{ r.s.Span.Name }</a>
										if r.toggle != "" && !r.open {
											<span class="shrink-0 text-[11px] text-muted">+{ itoa(r.below) }</span>
										}
									</span>
									<svg class="span-track" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
										<rect x={ pct(r.offset) } y="0" width={ pct(r.width) } height="6" class={ "span-bar", "tone-" + string(spanTone(r.s.Span.Status)), templ.KV("span-marker", r.marker) }></rect>
									</svg>
									<span class="text-xs whitespace-nowrap text-muted">
										{ durationText(r.duration) } · { string(r.s.Span.Status) }
										if r.sourceMark != "" {
											· time { r.sourceMark }
										}
										if p := placement(r.s.Seq, snap); p != "" {
											· { p }
										}
									</span>
								</li>
							}
						</ol>
						if r := pickSpan(rows, st.query.Get("span")); r != nil {
							<aside class="card stick space-y-3 text-sm" aria-label="Span detail">
								<div class="flex items-start gap-2">
									<h3 class="min-w-0 font-semibold break-words">{ r.s.Span.Name }</h3>
									<a class="close-x" href={ templ.SafeURL(st.href(map[string][]string{"span": nil})) } hx-swap={ keepPlace } aria-label="Close the span detail">×</a>
								</div>
								<dl class="kv kv-tight">
									<dt>span</dt>
									<dd class="break-all">{ r.id }</dd>
									<dt>start</dt>
									<dd>{ r.s.Span.Start }</dd>
									<dt>end</dt>
									<dd>{ orElse(r.s.Span.End, "not ended") }</dd>
									<dt>status</dt>
									<dd>{ string(r.s.Span.Status) }</dd>
									<dt>time source</dt>
									<dd>{ string(r.s.TSSource) }</dd>
									for _, k := range sortedKeys(r.s.Attrs) {
										if !isRef(k) {
											<dt class="break-all">{ k }</dt>
											<dd class="break-all">{ attrText(r.s.Attrs[k]) }</dd>
										}
									}
								</dl>
								@signalDetail(st, r.s)
								for _, l := range r.s.Span.Links {
									<a class="link block text-xs" href={ templ.SafeURL(st.href(map[string][]string{"trace": {l.TraceID}, "span": nil, "open": nil})) }>Follow the link to { l.TraceID }</a>
								}
							</aside>
						}
					</div>
				</div>
			}
		}
	}
}

func foldTitle(r foldedSpan) string {
	if r.open {
		return "Fold the " + itoa(r.below) + " spans under " + r.s.Span.Name
	}
	return "Show the " + itoa(r.below) + " spans under " + r.s.Span.Name
}

func boolText(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func pickSpan(rows []spanRow, id string) *spanRow {
	for i := range rows {
		if id != "" && rows[i].id == id {
			return &rows[i]
		}
	}
	return nil
}

templ tableView(st *state, snap signalSnapshot, all []contract.Signal) {
	if list := st.markSteps(tables(all)); true {
		@emptyNotice(st, snap, len(list))
		for _, t := range list {
			<section class="space-y-2" aria-label={ "table " + t.name }>
				<h3 class="text-sm font-semibold">{ t.name } <span class="font-normal text-muted">latest { itoa(len(t.rows)) } of { itoa(t.total) } rows</span></h3>
				<div class="flex flex-wrap gap-1">
					for _, c := range t.columns {
						<a href={ templ.SafeURL(st.toggle("hide", t.name+"."+c)) } class={ "pill", templ.KV("pill-on", !slices.Contains(st.query["hide"], t.name+"."+c)) }>{ c }</a>
					}
				</div>
				<div class="card overflow-x-auto p-0">
					<table class="grid-table">
						<thead>
							<tr>
								<th>time</th>
								if t.steps {
									<th>step</th>
								}
								for _, c := range visible(st, t) {
									<th>{ c }</th>
								}
								<th>bundle</th>
							</tr>
						</thead>
						<tbody>
							for i, s := range t.rows {
								<tr>
									<td class="font-mono text-xs"><a class="link" href={ templ.SafeURL(st.signalHref(s)) }>{ clock(s.TS) }</a></td>
									if t.steps {
										<td>
											@stepLinks(st, st.correlation().stepsOf(s))
										</td>
									}
									for _, c := range visible(st, t) {
										<td>{ cellOf(s, t.bodies[i], c) }</td>
									}
									<td class="text-xs text-muted">{ placement(s.Seq, snap) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
	}
}

func visible(st *state, t signalTable) []string {
	var out []string
	for _, c := range t.columns {
		if !slices.Contains(st.query["hide"], t.name+"."+c) {
			out = append(out, c)
		}
	}
	return out
}

func pickSource(sources []logSource, name string) *logSource {
	for i := range sources {
		if sources[i].name == name {
			return &sources[i]
		}
	}
	if len(sources) > 0 {
		return &sources[0]
	}
	return nil
}

templ logsView(st *state, snap signalSnapshot) {
	if sources := logSources(snap.signals); true {
		@emptyNotice(st, snap, len(sources))
		if src := pickSource(sources, st.query.Get("source")); src != nil {
			<div class="flex flex-wrap gap-1" aria-label="Log sources">
				for _, s := range sources {
					<a href={ templ.SafeURL(st.href(map[string][]string{"source": {s.name}})) } class={ "pill", templ.KV("pill-on", s.name == src.name) }>{ s.name } · { itoa(len(s.lines)) }</a>
				}
			</div>
			<div class="console log-box">
				<div>
					for _, l := range lastN(src.lines, logWindow) {
						<div><span class="text-muted">{ clock(l.TS) }</span> { logBody(l) }</div>
					}
				</div>
			</div>
		}
	}
}

func logBody(s contract.Signal) string {
	if s.Event == nil {
		return ""
	}
	return s.Event.Body
}
