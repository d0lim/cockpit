package screen

import (
	"net/url"
	"strings"
	"unicode"

	"github.com/d0lim/cockpit/internal/hub/api"
	"github.com/d0lim/cockpit/internal/hub/lifecycle"
)

const cockpitHeaders = `{"X-Cockpit":"1"}`

const htmxConfig = `{"includeIndicatorCSS":false,"defaultSwap":"innerHTML"}`

const keepPlace = "innerHTML show:none"

templ layout(st *state, title string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-live="connecting">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title } · { st.self().Name } · cockpit</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script src="/assets/htmx.min.js"></script>
			<script src="/assets/hx-ws.min.js"></script>
			<script src="/assets/app.js"></script>
		</head>
		<body hx-boost:inherited="true" hx-headers:inherited={ cockpitHeaders } class="bg-bg text-fg antialiased">
			<div hx-ws:connect={ "/live?screen=" + url.QueryEscape(st.screenParam()) } hx-swap="none" class="hidden"></div>
			<a id="follow" href="/" hx-swap={ keepPlace } class="hidden" tabindex="-1" aria-hidden="true"></a>
			<div class="shell">
				@sidebar(st)
				<div class="main">
					@body
				</div>
			</div>
			<div id="action-result" class="toast" aria-live="polite"></div>
		</body>
	</html>
}

templ partial(id string, c templ.Component) {
	<hx-partial hx-target={ "#" + id } hx-swap="outerMorph">
		@c
	</hx-partial>
}

func initials(name string) string {
	var words [][]rune
	var cur []rune
	flush := func() {
		if len(cur) > 0 {
			words = append(words, cur)
			cur = nil
		}
	}
	runes := []rune(strings.TrimSpace(name))
	for i, r := range runes {
		switch {
		case !unicode.IsLetter(r) && !unicode.IsDigit(r):
			flush()
			continue
		case i > 0 && unicode.IsUpper(r) && unicode.IsLower(runes[i-1]), i > 0 && unicode.IsDigit(r) != unicode.IsDigit(runes[i-1]):
			flush()
		}
		cur = append(cur, r)
	}
	flush()
	switch {
	case len(words) == 0:
		return "?"
	case len(words) == 1 && len(words[0]) > 1:
		return strings.ToUpper(string(words[0][:2]))
	case len(words) == 1:
		return strings.ToUpper(string(words[0]))
	}
	return strings.ToUpper(string(words[0][0]) + string(words[len(words)-1][0]))
}

func stackCount(l api.HubList) int {
	n := len(l.Foreign)
	for _, o := range l.Orphans {
		if o.Hub == "" {
			n++
		}
	}
	return n
}

func hubTitle(h api.HubItem) string {
	if h.Up {
		return h.Name + " · running at " + h.URL
	}
	return h.Name + " · not running · " + h.Home
}

func otherHubs(l api.HubList) []api.HubItem {
	var out []api.HubItem
	for _, h := range l.Hubs {
		if !h.Self {
			out = append(out, h)
		}
	}
	return out
}

func (st *state) address() string {
	if st.s == nil {
		return ""
	}
	return "127.0.0.1:" + itoa(st.s.d.Identity.Port)
}

func (st *state) onRuns() bool { return st.path != "/stacks" && st.path != "/hub" }

func sideNote(r api.RunItem) string {
	switch {
	case r.Phase == lifecycle.Queued:
		return "queued #" + itoa(r.Position)
	case isActive(r):
		return lifecycle.StageLabel(r.Phase)
	case r.Env == lifecycle.EnvUp:
		return "up"
	case r.Env == lifecycle.EnvStopped:
		return "stopped"
	}
	return r.PhaseLabel
}

templ sidebar(st *state) {
	<aside id="sidebar" class="sidebar" aria-label="This hub">
		<a href="/" class="side-hub" title={ hubTitle(st.self()) }>
			<span class="side-mark">{ initials(st.self().Name) }</span>
			<span class="min-w-0 leading-tight">
				<span class="block truncate font-semibold">{ st.self().Name }</span>
				<span class="block truncate font-mono text-[11px] text-muted">{ st.address() }</span>
			</span>
		</a>
		if st.list.DockerDown {
			<p class="side-alert">Docker does not answer</p>
		}
		if st.list.TickError != nil {
			<p class="side-alert">The last tick failed</p>
		}
		<nav class="side-nav" aria-label="Hub screens">
			<a href="/" class={ "side-link", templ.KV("side-on", st.onRuns()) }>
				Runs
				<span class="side-count">{ itoa(len(st.list.Runs)) }</span>
			</a>
			<a href="/stacks" class={ "side-link", templ.KV("side-on", st.path == "/stacks") } title="Compose projects no hub runs">
				Other stacks
				if n := stackCount(st.list); n > 0 {
					<span class="side-count-warn">{ itoa(n) }</span>
				}
			</a>
			<a href="/hub" class={ "side-link", templ.KV("side-on", st.path == "/hub") } title="This hub's identity and the hubs on this host">Hub</a>
		</nav>
		if g := groupRuns(st.list); true {
			if len(g.Pending) > 0 {
				<section class="side-more" aria-label="Now">
					<h2 class="side-title">Now</h2>
					for _, r := range g.Pending {
						@sideRun(st, r)
					}
				</section>
			}
			<section class="side-more" aria-label="Kept environments">
				<h2 class="side-title">
					Kept environments
					<span class="ml-auto font-normal tracking-normal">{ itoa(st.list.Pool.Size) } / { itoa(st.list.Pool.Max) }</span>
				</h2>
				for _, r := range g.Pool {
					@sideRun(st, r)
				}
				if len(g.Pool) == 0 {
					<p class="px-2 text-xs text-muted">None kept.</p>
				}
				<p class="mt-1 px-2 text-[11px] text-muted">Running { itoa(st.list.Up.Count) } / { itoa(st.list.Up.Cap) }</p>
			</section>
		}
		if others := otherHubs(st.list); len(others) > 0 {
			<section class="side-more" aria-label="Other hubs">
				<h2 class="side-title">Hubs</h2>
				for _, h := range others {
					if h.Up {
						<a href={ templ.SafeURL(h.URL + "/") } hx-boost="false" class="side-run" title={ hubTitle(h) }>
							<span class="dot tone-ok"></span>
							<span class="min-w-0 truncate">{ h.Name }</span>
							<span class="side-note">up</span>
						</a>
					} else {
						<a href="/hub#hubs" class="side-run" title={ hubTitle(h) }>
							<span class="dot tone-idle"></span>
							<span class="min-w-0 truncate text-muted">{ h.Name }</span>
							<span class="side-note">not running</span>
						</a>
					}
				}
			</section>
		}
		<p class="side-live">
			<span class="live-dot size-2 rounded-full"></span>
			<span class="live-text"></span>
		</p>
	</aside>
}

templ sideRun(st *state, r api.RunItem) {
	<a href={ templ.SafeURL(defaultPath(r, st.list)) } class={ "side-run", templ.KV("side-on", st.run != nil && st.run.ID == r.ID) } title={ r.ID }>
		@runMark(r, false)
		<span class="min-w-0 truncate">{ r.Suite } · { short(r.SHA) }</span>
		<span class="side-note">{ sideNote(r) }</span>
	</a>
}

templ problemBody(status int, message string) {
	<main class="page page-text">
		<section class="card max-w-xl">
			<p class="label">{ itoa(status) }</p>
			<p class="mt-1 text-base">{ message }</p>
			<p class="mt-4"><a href="/" class="link">Back to the runs</a></p>
		</section>
	</main>
}
